# CasaFlow Playwright walkthrough recorder
CASAFLOW_BASE_URL=https://hotel-ops-pilot.vercel.app
# Set these locally; never commit real passwords.
MANAGER_EMAIL=raghav007ff+casaflow-manager@gmail.com
MANAGER_PASSWORD=
FRONTDESK_EMAIL=raghav007ff+casaflow-desk@gmail.com
FRONTDESK_PASSWORD=
# Optional: include a real demo worker account to verify auto-dispatch.
MAINTENANCE_EMAIL=
MAINTENANCE_PASSWORD=
# Alternative optional worker account:
HOUSEKEEPING_EMAIL=
HOUSEKEEPING_PASSWORD=
# Production run creates a test guest request and uses a room QR.
E2E_ALLOW_PRODUCTION_MUTATIONS=0
SHOW_BROWSER=0


# Public interactive demo - server-side only. Never prefix these with VITE_.
# Add real values directly to Vercel Project Settings > Environment Variables.
SUPABASE_SECRET_KEY=
DEMO_SESSION_PEPPER=
CRON_SECRET=
# Optional Cloudflare Turnstile secret (only after adding the client widget/site key).
DEMO_TURNSTILE_SECRET_KEY=
VITE_DEMO_TURNSTILE_SITE_KEY=
